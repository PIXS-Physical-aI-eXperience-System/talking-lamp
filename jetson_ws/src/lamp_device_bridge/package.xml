<?xml version="1.0"?>
<package format="3">
  <name>lamp_device_bridge</name><version>0.1.0</version>
  <description>ROS bridge for Talking Lamp audio, direction and LED.</description>
  <maintainer email="maintainers@example.com">Talking Lamp maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
